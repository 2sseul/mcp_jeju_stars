# 실제 키는 `.env` 에 넣는다 — `.env` 는 커밋되지 않는다(.gitignore).
# 이 파일은 **이름만** 남긴다. 값을 채워 넣지 말 것.

# 카카오 개발자 콘솔 [내 애플리케이션 → 앱 키].
# JavaScript 키는 scripts/review_parking.py 의 지도·로드뷰가 쓴다.
# 브라우저에 그대로 실려 나가므로 [플랫폼 → Web] 사이트 도메인 등록이 접근 통제다
# (http://localhost:8765 를 등록해야 검토 도구가 뜬다).
KAKAO_JAVASCRIPT_API_KEY=
KAKAO_REST_API_KEY=

# 기상청 API 허브 — GK2A 위성 구름·안개(P7, server/clients/gk2a.py).
KMA_API_KEY=

# 브이월드(국토교통부) 오픈API — 지도 배경의 항공사진(국토지리정보원).
# 없으면 Esri World Imagery 로 떨어진다(제주 z18까지 · VWorld 는 z19까지).
# **이 키는 지도 HTML 에 그대로 실려 나간다** — 클라이언트가 직접 타일을 받는
# 방식이라 피할 수 없다. VWorld 콘솔의 도메인 등록이 실질적인 접근 통제다.
VWORLD_API_KEY=

# 배경 타일을 통째로 갈아끼울 때. 공급자를 바꿔 보려고 코드를 안 고치기 위한 구멍이다.
# {z}·{x}·{y} 자리표시자를 그대로 둔다. 함께 MAP_TILE_CREDIT·MAP_TILE_MAX_ZOOM.
MAP_TILE_URL=
