# 이 파일을 `.env` 로 복사해서 값을 채운다. `.env` 는 .gitignore 가 막는다.
#
# 환경변수가 파일보다 우선한다(`modules/env.py`). 컨테이너에는 `.env` 를 넣지 않고
# docker-compose 의 env_file·environment 로 넣는다 — 비밀은 이미지에 굽지 않는다.
#
# 판정에 쓰는 데이터는 전부 로컬 파일이거나 무인증 API 라,
# **키가 하나도 없어도 서버는 뜨고 도구 세 개는 다 답한다.** 아래는 전부 선택이다.

# ── 서버 ────────────────────────────────────────────────────────────
# 바인딩 주소·포트. 컨테이너는 0.0.0.0 으로 뜬다(docker-compose 의 command).
MCP_HOST=127.0.0.1
MCP_PORT=11000

# 응답의 `map_url` 이 달고 나가는 겉면 주소. 바인딩 주소와 따로 둔다 —
# 0.0.0.0 은 브라우저가 열 수 있는 주소가 아니다.
# ngrok 공개 URL 이 정해지면 반드시 그 주소로 바꿔야 지도 링크가 밖에서 열린다.
MAP_BASE_URL=http://127.0.0.1:11000

# ── 지도 배경 ───────────────────────────────────────────────────────
# 없으면 Esri World Imagery 로 떨어진다(z18. VWorld 는 z19).
# 주의: 타일 키는 지도 HTML 에 그대로 실린다 — 클라이언트가 직접 타일을 받기
# 때문에 피할 수 없다. VWorld 콘솔에서 도메인을 등록해 제한하는 것이 실질적 통제다.
VWORLD_API_KEY=

# 공급자를 바꿔 볼 때 쓰는 구멍. 주면 VWORLD_API_KEY 보다 우선한다.
# `{z}`·`{x}`·`{y}` 자리표시자는 그대로 둔다.
MAP_TILE_URL=
MAP_TILE_CREDIT=
MAP_TILE_MAX_ZOOM=

# ── ngrok ───────────────────────────────────────────────────────────
# docker-compose 의 ngrok 서비스가 쓴다. https://dashboard.ngrok.com 에서 발급.
# 비우면 ngrok 컨테이너만 못 뜨고 MCP 서버 자체는 뜬다.
# 공개 URL 은 http://localhost:4040 (웹 인스펙터)에서 확인한다.
NGROK_AUTHTOKEN=

# ── 배치 전용 ───────────────────────────────────────────────────────
# 판정에는 쓰지 않는다. data/ 를 다시 수집할 때만 필요하고,
# 그 스크립트(`scripts/`)는 이 배포 묶음에 없다 — 개발 저장소 쪽이다.
KAKAO_REST_API_KEY=
KMA_API_KEY=
