# Python
__pycache__/
*.py[cod]
.venv/

# API 키 (카카오 · 기상청). 절대 커밋하지 않는다
.env
.env.*
!.env.example

# Open-Meteo requests_cache DB (컨테이너에서는 이 디렉터리를 볼륨으로 잡는다)
.cache/

# 개인용 로컬 Claude 설정 (팀 공유 대상 아님)
.claude/settings.local.json

# 스크래치 (Crossref API 응답 등 임시 조회 결과)
cr.json

# /pr 커맨드가 만드는 임시 PR 본문
.pr-body.md

# 발표용 시각화 산출물 (scripts/build_*_map.py · build_spot_report.py 로 재생성)
outputs/

# 표고 격자 (FABDEM). CC BY-NC-SA 4.0 이라 재배포하면 파생물도 같은 조건에 묶인다.
# 원본 tif 도 거기서 만든 npz 도 커밋하지 않는다 — 저장소가 나르는 것은
# `scripts/build_elevation_grid.py` 뿐이고, 받은 사람이 한 번 돌리면 된다.
data/elevation/

# 토지대장 원본(375MB). GitHub 100MB 제한을 넘고 코드가 읽지 않는다 —
# 저장소가 나르지 않고 로컬에만 둔다.
data/land/
