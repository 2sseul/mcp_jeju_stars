# 키가 들어 있다. 이 폴더를 넘기거나 올릴 때 절대 함께 가면 안 된다.
# (`.env.example` 은 이 패턴에 안 걸린다 — 정확히 `.env` 인 것만 막는다.)
.env

# 가상환경. 로컬에서 `uv venv` 로 만드는 것이고 200MB 에 육박한다.
# data/ 34MB 보다 이쪽이 훨씬 크니 빠뜨리면 저장소가 통째로 무거워진다.
.venv/
venv/

# 실행 중 생기는 것 — 셋 다 코드가 알아서 만든다.
# outputs/maps 는 modules/maps.py, .cache 는 modules/clients/open_meteo.py 가
# mkdir(parents=True, exist_ok=True) 로 만드니 빈 디렉터리를 남겨둘 필요가 없다.
.cache/
outputs/
**/__pycache__/
*.py[cod]

# 편집기·OS 가 흘리는 것
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
